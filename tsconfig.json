{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ES2020",
    // "bundler" matches how esbuild actually resolves imports, so extensionless
    // paths like "./core/active" type-check the same way they build.
    "moduleResolution": "bundler",
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "types": ["chrome"]
  },
  // rootDir was "src". Dropped so the test folder is type-checked too; nothing
  // emits through tsc anyway, esbuild writes dist/.
  "include": ["src", "test"]
}
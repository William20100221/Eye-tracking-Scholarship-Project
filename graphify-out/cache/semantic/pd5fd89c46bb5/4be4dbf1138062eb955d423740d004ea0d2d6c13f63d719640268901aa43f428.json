{"nodes": [{"id": "vertical_accuracy_vertical_accuracy_doc", "label": "More face landmarks, for vertical accuracy", "file_type": "document", "source_file": "VERTICAL-ACCURACY.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "vertical_accuracy_gaze_pipeline", "label": "Gaze pipeline (MediaPipe 478 landmarks -> features -> ridge -> screen pixel)", "file_type": "concept", "source_file": "VERTICAL-ACCURACY.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "vertical_accuracy_mediapipe_facelandmarker", "label": "MediaPipe FaceLandmarker", "file_type": "concept", "source_file": "VERTICAL-ACCURACY.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "vertical_accuracy_irisrelativeextractor", "label": "IrisRelativeExtractor", "file_type": "concept", "source_file": "VERTICAL-ACCURACY.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measures iris relative to eye so head movement cancels out; 13 landmarks, 9 features."}, {"id": "vertical_accuracy_eyelid_ruler_problem", "label": "Problem 1: eyelid ruler moves", "file_type": "rationale", "source_file": "VERTICAL-ACCURACY.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lid-to-lid denominator shrinks on squint/smile/downward look and goes to zero on blink; horizontal uses fixed eye corners so it does not suffer."}, {"id": "vertical_accuracy_head_pitch_problem", "label": "Problem 2: no head-pitch signal", "file_type": "rationale", "source_file": "VERTICAL-ACCURACY.md", "source_location": "L38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Looking down vs nodding down land in same place; nose height moves for both."}, {"id": "vertical_accuracy_head_roll_leak", "label": "Problem 3: head roll leaks horizontal into vertical", "file_type": "rationale", "source_file": "VERTICAL-ACCURACY.md", "source_location": "L43", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "vertical_accuracy_iris_ring_ruler", "label": "Iris ring as fixed ruler (469-472, 474-477)", "file_type": "rationale", "source_file": "VERTICAL-ACCURACY.md", "source_location": "L52", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Iris ~11.7mm in all adults, constant physical unit; apparent size gives head distance."}, {"id": "vertical_accuracy_eye_corner_zero_line", "label": "Eye corners as vertical zero line (33/133, 362/263)", "file_type": "rationale", "source_file": "VERTICAL-ACCURACY.md", "source_location": "L53", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bone-anchored, does not move on blink; replaces eyelid as reference."}, {"id": "vertical_accuracy_eyelid_openness_feature", "label": "Eyelid openness as model feature / blink detection", "file_type": "rationale", "source_file": "VERTICAL-ACCURACY.md", "source_location": "L54", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets regression subtract lid-droop bias; averaging three lid points cuts jitter."}, {"id": "vertical_accuracy_face_midline_pitch", "label": "Face midline head-pitch estimate (10,168,1,152)", "file_type": "rationale", "source_file": "VERTICAL-ACCURACY.md", "source_location": "L55", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ratio of upper-face to lower-face length is pitch estimate independent of forehead size; z depth gives second opinion."}, {"id": "vertical_accuracy_landmarks_ts", "label": "Landmarks.ts", "file_type": "code", "source_file": "VERTICAL-ACCURACY.md", "source_location": "L70", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "vertical_accuracy_verticalleanextractor", "label": "VerticalLeanExtractor (13 features)", "file_type": "code", "source_file": "VERTICAL-ACCURACY.md", "source_location": "L71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommended: generalises best on unseen dots."}, {"id": "vertical_accuracy_verticalfullextractor", "label": "VerticalFullExtractor (26 features)", "file_type": "code", "source_file": "VERTICAL-ACCURACY.md", "source_location": "L71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Comparison arm only; fits cal dots best but overfits."}, {"id": "vertical_accuracy_featureextractor", "label": "FeatureExtractor (abstract)", "file_type": "code", "source_file": "VERTICAL-ACCURACY.md", "source_location": "L71", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "vertical_accuracy_active_extractor_switch", "label": "active.ts activeExtractor switch", "file_type": "code", "source_file": "VERTICAL-ACCURACY.md", "source_location": "L72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single switch for live extractor; also breaks a circular-import crash."}, {"id": "vertical_accuracy_standardizedridgeestimator", "label": "StandardizedRidgeEstimator", "file_type": "code", "source_file": "VERTICAL-ACCURACY.md", "source_location": "L73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ridge penalises all weights equally; small-spread features like head pitch get deleted unless features are standardised first. Lambda moves to new scale (~10)."}, {"id": "vertical_accuracy_validation_ts", "label": "Validation.ts (leaveOneDotOut, chooseLambda)", "file_type": "code", "source_file": "VERTICAL-ACCURACY.md", "source_location": "L74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holds out whole d